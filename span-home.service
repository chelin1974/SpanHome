# systemd unit for the SPAN Panel HomeKit bridge. See "Linux (systemd)" in the README.
#
#   sudo cp span-home.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now span-home
#   journalctl -u span-home -f      # the setup code and dashboard address are printed at startup
#
# Expects the jar, span-home.config.json and span-home.credentials.json in /opt/span-home,
# owned by the span-home user. Adjust User, WorkingDirectory and the paths if yours differ.

[Unit]
Description=SPAN Panel HomeKit bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=span-home
WorkingDirectory=/opt/span-home
ExecStart=/usr/bin/java -jar /opt/span-home/span-home.jar --config /opt/span-home/span-home.config.json
Restart=on-failure
RestartSec=10

# The credentials file can switch every breaker in the house and the state file holds the
# HomeKit pairing, so keep everything the bridge writes readable only by this user.
UMask=0077

# HomeKit needs mDNS on the LAN, so no network namespacing here.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
